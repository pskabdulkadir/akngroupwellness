# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Yerel geliştirme adresi. Üretim URL'sini Vercel ortam değişkeniyle ayarlayın.
APP_URL="http://localhost:3000"

NODE_ENV="development"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Supabase PostgreSQL bağlantı dizesi; Vercel Functions için Session Pooler adresini kullanın.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
DATABASE_SSL="true"
PGPOOL_MAX=10
CRON_SECRET="replace-with-a-long-random-secret"

# ADMIN AUTHENTICATION & SECURITY (At least 12 characters for password, 32 for JWT secret)
ADMIN_PASSWORD="YourSecureAdminPassword2026!"
ADMIN_JWT_SECRET="your_strong_admin_jwt_secret_key_min_32_characters_here"
MEMBER_JWT_SECRET="your_strong_member_jwt_secret_key_min_32_characters_here"
