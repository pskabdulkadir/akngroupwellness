# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://my-monoline-app.onrender.com).
APP_URL="https://my-monoline-app.onrender.com"

# NODE RUNTIME & PORT (Render sets PORT dynamically; defaults to 3000 locally)
NODE_ENV="production"
PORT=10000

# POSTGRESQL-18 CONFIGURATION (Render / Local)
# Yerel Bağlantı: postgresql://postgres:postgres@localhost:5432/monoline
# Render İç Ağ Bağlantısı: postgresql://monoline_prod_db_user:[SIFRE]@dpg-dbqdqi5g1s2s73e1o7lg-a/monoline_prod_db
# Render Dış Ağ Bağlantısı: postgresql://monoline_prod_db_user:[SIFRE]@dpg-dbqdqi5g1s2s73e1o7lg-a.frankfurt-postgres.render.com/monoline_prod_db
DATABASE_URL="postgresql://monoline_prod_db_user:YOUR_PASSWORD@dpg-dbqdqi5g1s2s73e1o7lg-a/monoline_prod_db"
DATABASE_SSL="true"

# ADMIN AUTHENTICATION & SECURITY (At least 12 characters for password, 32 for JWT secret)
ADMIN_PASSWORD="YourSecureAdminPassword2026!"
ADMIN_JWT_SECRET="your_strong_admin_jwt_secret_key_min_32_characters_here"
MEMBER_JWT_SECRET="your_strong_member_jwt_secret_key_min_32_characters_here"

